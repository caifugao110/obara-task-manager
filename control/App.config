<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="BackendPort" value="5000" />
    <add key="FrontendPort" value="5173" />
    <add key="MonitorInterval" value="2000" />
    <add key="KbApiPort" value="8080" />
    <add key="KbConsolePort" value="80" />
    <!-- 自动重启（自愈）：服务进程退出、或进程还在但端口长时间无响应
         （nodemon 崩溃后 "app crashed" 空转）时，控制台按退避间隔重新拉起。
         只对「本控制台启动的进程」生效，不会去接管 start.bat 拉起的实例。
         AutoRestartDelays 为重试间隔（秒），按顺序递增，最后一项重复使用。 -->
    <add key="AutoRestartEnabled" value="true" />
    <add key="AutoRestartMaxAttempts" value="5" />
    <add key="AutoRestartWindowMinutes" value="10" />
    <add key="AutoRestartDelays" value="15,30,60,120" />
  </appSettings>
  <!-- Per-Monitor DPI awareness v2 — prevents Windows from bitmap-
       stretching our custom-drawn title-bar buttons, GitHub icon,
       and Chinese text on high-DPI / 4K displays.  Without this entry,
       all GDI+ line art gets upscaled and looks blurry / low-res. -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Windows.Forms.DoNotLoadLatestRichEditControl=false" />
  </runtime>
</configuration>
