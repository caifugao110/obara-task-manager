# ======================
# Obara Task Manager 环境变量配置示例
# ======================
# 复制此文件为 .env 并根据实际情况修改
# 注意：.env 文件不应提交到版本控制系统

# ----------------------
# 服务器配置
# ----------------------
# 后端服务端口
PORT=5000

# 运行环境 (development, production)
# 开发环境用 development；生产部署必须改为 production，
# 否则 Express 错误响应会把完整堆栈回传给客户端（见 server.js 错误处理分支）
NODE_ENV=development

# ----------------------
# JWT 认证配置
# ----------------------
# JWT 签名密钥 - 生产环境务必修改为随机字符串！
# 留空（不设置）时服务将直接拒绝启动（security.js 强制校验）
# 复制本文件为 .env 后，务必填写真实值再启动
JWT_SECRET=

# JWT 过期时间
JWT_EXPIRES_IN=3d

# JWT 签发方与接收方（可选，一般保持默认即可）
JWT_ISSUER=obara-task-manager
JWT_AUDIENCE=obara-task-manager-api

# ----------------------
# 默认管理员账户配置（仅首次启动时生效）
# ----------------------
# 默认管理员用户名（首次启动后可在系统中修改）
DEFAULT_ADMIN_USERNAME=superadmin
# 默认管理员密码（仅首次启动时生效）
# 留空（不设置）时，首次启动将随机生成密码并在控制台仅显示一次；
# 如显式设置，生产环境务必使用强密码并在登录后立即修改。
DEFAULT_ADMIN_PASSWORD=

# ----------------------
# 安全配置
# ----------------------
# 登录限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
# 登录接口按 IP 的第一层限流：15 分钟窗口内每 IP 最大登录请求数（默认 300）。
# 用于堵住「IP+用户名」细粒度限流的密码喷洒缺口；共用出口 IP 的内网环境
# 若早高峰误触发，可适当调大
LOGIN_IP_RATE_LIMIT_MAX=300
# 全局 API 限流：15 分钟窗口内每 IP 最大请求数（默认 3000，OPTIONS 预检与本机回环不计）
# API_RATE_LIMIT_MAX=3000

# ----------------------
# 数据库配置
# ----------------------
# SQLite 数据库文件路径
SQLITE_DB_PATH=./data.db

# ----------------------
# 仕样书配置
# ----------------------
# 仕样书 PDF 共享目录路径
SPEC_SHARE_PATH=\\192.168.160.6\仕样书$

# ----------------------
# 各产品大日程配置
# ----------------------
# 各产品大日程 Excel 文件路径。状态跟踪页的「数量、纳期、已发图」会优先取此表，
# 解析工作表：南京焊钳、上海焊钳、南京焊钳修改、上海焊钳修改；
# 「南京」对应工厂 O/NJG，「上海」对应 O/SHA。取不到时回退原有规则（PDF/已存数据）。
PRODUCTION_SCHEDULE_PATH=\\192.168.160.70\各产品大日程\各产品大日程.xls
# 本地参考文件位置：backend/templates/production-schedule/各产品大日程.xls
# （仅用于查看/离线排查，实际解析路径以上面的 PRODUCTION_SCHEDULE_PATH 为准）
# 大日程解析结果缓存时长（毫秒，默认 5 分钟）；共享文件更新后最多滞后该时长生效
# PRODUCTION_SCHEDULE_CACHE_MS=300000
#
# --- 共享盘故障隔离（可选，一般保持默认）---
# 共享盘读取放在独立子进程里执行，主进程只等结果：SMB 会话失效时 UNC 调用会在
# Windows 内核里挂住不返回，若不隔离会把 libuv 线程池占满，后端活着却不再响应
# HTTP（watchdog 只看进程退出码，察觉不到）。这里是子进程的硬超时，超时即杀子进程。
# PRODUCTION_SCHEDULE_WORKER_TIMEOUT_MS=20000
# 熔断器：连续失败达到阈值后停止访问共享盘一段时间，避免故障期间反复制造挂起调用。
# 熔断期间普通查询返回「最后一次成功解析」的缓存；管理员调用排障接口
# GET /api/system/schedule-probe 会绕过熔断做一次真实探测，成功即自动恢复。
# PRODUCTION_SCHEDULE_BREAKER_THRESHOLD=3
# PRODUCTION_SCHEDULE_BREAKER_COOLDOWN_MS=3600000
#
# --- 共享目录访问凭据（可选，按需配置）---
# 后端以 Windows 服务 / 计划任务「开机自启」时运行在 Session 0（非交互会话），
# 该会话没有登录用户对共享盘的 SMB 认证，读取共享文件会报 EPERM，
# 而管理员在资源管理器里却能正常打开——这不是路径错误。
# 两种解决方式，任选其一：
#   1) 在 192.168.160.70 上给「运行后端服务的账户」授予该共享的读权限
#      （共享权限 + NTFS 权限都要给；若服务跑在 SYSTEM 下，账户是机器账户 <机器名>$）；
#   2) 配置下面两项凭据。读取失败时后端会自动执行一次
#      net use \\192.168.160.70\各产品大日程 /user:<用户> <密码> 再重试。
# 凭据只用于建立共享连接，不会写入日志。注意：修改后需重启后端。
# PRODUCTION_SCHEDULE_UNC_USER=
# PRODUCTION_SCHEDULE_UNC_PASSWORD=
#

# ----------------------
# 共享路径访问状态（系统设置 → 状态监测）
# ----------------------
# 监测页对 SPEC_SHARE_PATH / PRODUCTION_SCHEDULE_PATH 做只读探测，
# 下面四项控制探测代价，一般无需改动。
# 单次探测硬超时（毫秒，默认 2500，最小 500）：超过即记为「访问超时」
# SHARE_STATUS_PROBE_TIMEOUT_MS=2500
# 探测前测共享主机 445/139 端口连通性的超时（毫秒，默认 1500，最小 300）；
# 端口不通即判定「主机不可达」并跳过 UNC 调用，避免等满 Windows 自身 30 秒超时
# SHARE_STATUS_HOST_TIMEOUT_MS=1500
# 可访问状态缓存时长（毫秒，默认 30000，最小 1000）
# SHARE_STATUS_OK_TTL_MS=30000
# 不可访问状态缓存时长（毫秒，默认 10000，最小 1000），比成功态短以便恢复后尽快生效
# SHARE_STATUS_FAIL_TTL_MS=10000

# ----------------------
# CORS 配置
# ----------------------
# 允许的前端地址，多个用逗号分隔
CORS_ORIGIN=https://task.obara.com.cn,http://localhost:5173,http://127.0.0.1:5173,http://192.168.160.25:5173,http://192.168.160.10:5173

# ----------------------
# Gitee API 配置 (用于版本检查)
# ----------------------
# Gitee 个人访问令牌，用于前端频繁获取仓库版本状态
# 获取地址: https://gitee.com/profile/personal_access_tokens
# 注意：请勿在此文件或任何文档中填写真实令牌，真实令牌仅放在 .env 中（已被 .gitignore 排除）
# 留空时前端版本检查会以匿名方式访问 Gitee（有速率限制，低频场景可接受）
GITEE_TOKEN=

# Gitee 仓库信息
GITEE_REPO_OWNER=caifugao110
GITEE_REPO_NAME=obara-task-manager

# ----------------------
# 设计规范知识库 (WeKnora) 接入配置
# ----------------------
# 是否启用设计规范知识库接入（未部署 WeKnora 时保持 false，页面会显示未连接）
WEKNORA_ENABLED=false
# WeKnora 后端 API 根地址（Docker 部署默认映射到宿主机 8080 端口）
WEKNORA_BASE_URL=http://127.0.0.1:8080/api/v1
# WeKnora 主工作空间 API Key（在 WeKnora「设置 → API Keys」创建，此处仅服务端使用）
WEKNORA_API_KEY=
# 其他工作空间的 API Key，多个用英文逗号分隔（WeKnora 的 Key 按工作空间隔离，
# 知识库建在多个工作空间时，把各自空间的 Key 都配上，页面会合并展示）
WEKNORA_EXTRA_API_KEYS=
# 普通请求超时（毫秒）
WEKNORA_TIMEOUT_MS=60000
# 遗留变量（可选，逗号分隔）：当前版本检索/问答始终使用页面上显式关联并勾选的知识库 ID，
# 请求未携带知识库 ID 时后端直接返回 400，此变量实际不参与检索/问答，无需配置
# WEKNORA_KNOWLEDGE_BASE_IDS=

# ----------------------
# 日志配置
# ----------------------
# 日志级别（预留变量）：当前版本代码未读取此变量，设置后不生效。
# 日志实际始终输出到控制台与 logs/ 下的日志文件，保留此项仅为与文档一致
# LOG_LEVEL=info

# 进程级兜底开关（uncaughtException / unhandledRejection）
# 默认留空：捕获到未处理的异常时只记录（完整堆栈追加到 logs/backend-crash.log），
# 进程继续提供服务，避免 5000 端口静默消失、前端全部请求变成 ECONNREFUSED。
# 设为 1 时记录后执行 process.exit(1)，便于 nodemon 等开发场景按崩溃重启。
# 生产环境请保持默认值。
# CRASH_EXIT_ON_UNCAUGHT=1
