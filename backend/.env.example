# ======================
# Obara Task Manager 环境变量配置示例
# ======================
# 复制此文件为 .env 并根据实际情况修改
# 注意：.env 文件不应提交到版本控制系统

# ----------------------
# 服务器配置
# ----------------------
# 后端服务端口
PORT=5000

# 运行环境 (development, production)
NODE_ENV=development

# ----------------------
# JWT 认证配置
# ----------------------
# JWT 签名密钥 - 生产环境务必修改为随机字符串！
# 注意：此密钥必须设置，否则服务无法启动
JWT_SECRET=your-secret-key-change-in-production-2026

# JWT 过期时间
JWT_EXPIRES_IN=7d

# JWT 签发方与接收方（可选，一般保持默认即可）
JWT_ISSUER=obara-task-manager
JWT_AUDIENCE=obara-task-manager-api

# ----------------------
# 默认管理员账户配置（仅首次启动时生效）
# ----------------------
# 默认管理员用户名（首次启动后可在系统中修改）
DEFAULT_ADMIN_USERNAME=superadmin
# 默认管理员密码（首次启动后应立即修改！）
# 生产环境务必设置为强密码！
DEFAULT_ADMIN_PASSWORD=admin123

# ----------------------
# 安全配置
# ----------------------
# 登录限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# ----------------------
# 数据库配置
# ----------------------
# SQLite 数据库文件路径（推荐）
SQLITE_DB_PATH=./data.db
# 遗留 JSON 数据库路径（仅首次启动时用于迁移到 SQLite，迁移完成后可删除）
DB_PATH=./db.json

# ----------------------
# 仕样书配置
# ----------------------
# 仕样书 PDF 共享目录路径
SPEC_SHARE_PATH=\\192.168.160.6\仕样书$

# ----------------------
# CORS 配置
# ----------------------
# 允许的前端地址，多个用逗号分隔
CORS_ORIGIN=https://task.obara.com.cn,http://localhost:5173,http://127.0.0.1:5173,http://192.168.160.25:5173,http://192.168.160.10:5173

# ----------------------
# Gitee API 配置 (用于版本检查)
# ----------------------
# Gitee 个人访问令牌，用于前端频繁获取仓库版本状态
# 获取地址: https://gitee.com/profile/personal_access_tokens
# 注意：请勿在此文件或任何文档中填写真实令牌，真实令牌仅放在 .env 中（已被 .gitignore 排除）
GITEE_TOKEN=your-gitee-personal-access-token

# Gitee 仓库信息
GITEE_REPO_OWNER=caifugao110
GITEE_REPO_NAME=obara-task-manager

# ----------------------
# 日志配置 (可选)
# ----------------------
# 日志级别 (error, warn, info, debug)
# LOG_LEVEL=info

# ----------------------
# 设计规范知识库 (WeKnora) 接入配置
# ----------------------
# 是否启用设计规范知识库接入（未部署 WeKnora 时保持 false，页面会显示未连接）
WEKNORA_ENABLED=false
# WeKnora 后端 API 根地址（Docker 部署默认映射到宿主机 8080 端口）
WEKNORA_BASE_URL=http://127.0.0.1:8080/api/v1
# WeKnora 空间 API Key（在 WeKnora「设置 → API Keys」创建，此处仅服务端使用）
WEKNORA_API_KEY=
# 默认检索的知识库 ID，多个用英文逗号分隔（在 WeKnora 中创建知识库后填入）
WEKNORA_KNOWLEDGE_BASE_IDS=
# 普通请求超时（毫秒）
WEKNORA_TIMEOUT_MS=60000
