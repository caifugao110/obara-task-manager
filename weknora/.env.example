# =============================================================================
# WeKnora 运行时配置（供 weknora/docker-compose.yml 使用）
#
# 用法：
#   1. 复制本文件为 .env：cp .env.example .env
#      （Windows CMD: copy .env.example .env）
#   2. 修改下面标记【必填】的项；
#   3. 密钥（JWT_SECRET / SYSTEM_AES_KEY）可用 scripts/gen-env.js 自动生成，
#      或直接用 start.bat / start.sh 一键生成 + 启动。
# =============================================================================

# ---------- 镜像版本 ----------
# 固定版本号，避免 latest 漂移导致不可预期的升级
WEKNORA_VERSION=v0.8.2

# ---------- 运行时基础 ----------
GIN_MODE=release
TZ=Asia/Shanghai
WEKNORA_LANGUAGE=zh-CN

# ---------- 端口 ----------
APP_PORT=8080
FRONTEND_PORT=80

# ---------- 数据库（postgres 容器，勿改主机名）----------
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123!@#
DB_NAME=WeKnora

# ---------- Redis ----------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=redis123!@#

# ---------- 检索引擎：postgres = paradedb 向量检索，无需额外组件 ----------
RETRIEVE_DRIVER=postgres

# ---------- 文档解析 ----------
DOCREADER_ADDR=docreader:50051

# ---------- 文件存储 ----------
STORAGE_TYPE=local

# ---------- 文件大小限制（MB）----------
MAX_FILE_SIZE_MB=50

# =============================================================================
# 【必填】安全密钥
#   JWT_SECRET      64 个十六进制字符（32 字节）
#   SYSTEM_AES_KEY  恰好 32 个字符（AES-256 主密钥，用于加密 API Key 等敏感字段）
#
# 生成方式（任选其一）：
#   node scripts/gen-env.js            # 自动写入 .env（推荐）
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#
# 注意：SYSTEM_AES_KEY 丢失则数据库中已加密的 API Key 等无法解密，请妥善保管。
# =============================================================================
JWT_SECRET=
SYSTEM_AES_KEY=

# =============================================================================
# 【必填】模型 API Key（供 scripts/setup.js 初始化模型时读取）
#
#   DEEPSEEK_API_KEY   对话模型（DeepSeek 官方 API），https://platform.deepseek.com 申请
#   BIGMODEL_API_KEY   向量模型（智谱 BigModel），https://open.bigmodel.cn 申请
#
# 取值优先级：--deepseek-key/--zhipu-key 命令行参数 > 同名环境变量 > 本文件。
# 三者都缺时 setup.js 才会交互式询问。模型建好后即加密存入 WeKnora 数据库，
# 之后重复执行 setup.js 不再需要这两个 Key。
# =============================================================================
DEEPSEEK_API_KEY=
BIGMODEL_API_KEY=
